<Window x:Class="Robotszimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Robotszimulator"
        mc:Ignorable="d"
        Title="Robot Szimulátor" Height="800" Width="1000" WindowState="Maximized" Background="Black">

    <Window.Resources>
        <!-- Sötét kártya stílus -->
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#282C34"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Sötét gomb stílus -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#282C34"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kiemelt Futtatás gomb -->
        <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#D19A66"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- 0. Felső vezérlősáv -->
            <RowDefinition Height="*"/>
            <!-- 1. Fő munkaterület (Program + Szimulátor) -->
            <RowDefinition Height="250"/>
            <!-- 2. Alsó sáv (Konzol, Napló, Változók) -->
        </Grid.RowDefinitions>

        <!-- 0. FELSŐ VEZÉRLŐSÁV -->
        <Border Grid.Row="0" Style="{StaticResource DarkCard}" Margin="0,0,0,6" Padding="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📁 Betöltés" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                <Button Content="💾 Mentés" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                <Button Content="▶ Futtatás" Style="{StaticResource RunButton}" Margin="0,0,8,0" Click="BtnFuttatas_Click"/>
                <Button Content="⏭ Nyomkövetés" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                <Button Content="⏹ Megállítás" Style="{StaticResource DarkButton}" Margin="0,0,16,0" Click="BtnMegallitas_Click"/>

                <TextBlock Text="Sebesség: lassú (1)" VerticalAlignment="Center" Foreground="#9DA5B4" FontSize="12" Margin="0,0,8,0"/>
                <Slider Width="120" VerticalAlignment="Center" Minimum="1" Maximum="10" Value="5" Margin="0,0,8,0" x:Name="slSebesseg"/>
                <TextBlock Text="gyors (10)" VerticalAlignment="Center" Foreground="#9DA5B4" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 1. KÖZÉPSŐ FŐ MUNKATERÜLET -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <!-- Bal: Program szerkesztő -->
                <ColumnDefinition Width="*"/>
                <!-- Jobb: Szimulátor és vezérlés -->
            </Grid.ColumnDefinitions>

            <!-- BAL OLDAL: Program (Blokkok / Szöveg) -->
            <Border Grid.Column="0" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <!-- Fejléc és nézetváltó -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Program" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Blokkok" Style="{StaticResource DarkButton}" Margin="0,0,4,0" Padding="8,4"/>
                            <Button Content="Szöveg" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Padding="8,4" Background="#1E1E1E"/>
                            <Button Content="+ Blokk hozzáadása" Style="{StaticResource RunButton}" Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Blokkok listája -->
                    <ScrollViewer>
                        <StackPanel>
                            <!-- Példa blokk sorok -->
                            <!--<StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="1" Width="20" Foreground="#5C6370" VerticalAlignment="Center"/>
                                <Border Background="#61AFEF" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="set count to 0" Foreground="#1E1E1E" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="2" Width="20" Foreground="#5C6370" VerticalAlignment="Center"/>
                                <Border Background="#61AFEF" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="set megy to true" Foreground="#1E1E1E" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="3" Width="20" Foreground="#5C6370" VerticalAlignment="Center"/>
                                <Border Background="#98C379" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="while megy" Foreground="#1E1E1E" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>-->
                            <!-- További blokkok... -->
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- JOBB OLDAL: Szimulátor és Vezérlők -->
            <Border Grid.Column="1" Style="{StaticResource DarkCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cím & Jelmagyarázat -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Szimulátor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="Felfedezett" Foreground="#9DA5B4" Margin="0,0,10,0"/>
                            <CheckBox Content="Felfedezetlen" Foreground="#9DA5B4" Margin="0,0,10,0"/>
                            <CheckBox Content="Fal" Foreground="#9DA5B4" Margin="0,0,10,0"/>
                            <CheckBox Content="Arany" Foreground="#9DA5B4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Térkép Canvas / Rács -->
                    <Border Grid.Row="1" Background="#181A1F" CornerRadius="6" BorderBrush="#282C34" BorderThickness="1">
                        <Canvas x:Name="TerkepCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Szenzor és statisztika adatok -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,10">
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="10" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Szenzor, a robot előtt" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock Text="" FontWeight="Bold" FontSize="14" Margin="0,4,0,0" x:Name="tbSzenzor"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="10" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="Kibányászott arany" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock Text="0" FontWeight="Bold" FontSize="16" Foreground="#E5C07B" Margin="0,4,0,0" x:Name="tbKibanyaszottArany"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="10" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Irány" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock Text="" FontWeight="Bold" FontSize="14" Margin="0,4,0,0" x:Name="tbIrány"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Kézi vezérlés panel -->
                    <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Kézi vezérlés" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⟳ Balra fordulás" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                                <TextBox Width="45" Background="#282C34" Foreground="White" BorderBrush="#3A3F4B" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,15,0"/>
                                <Button Content="↑ Előre" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                                <TextBox Width="45" Background="#282C34" Foreground="White" BorderBrush="#3A3F4B" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,15,0"/>
                                <Button Content="◆ Bányászás" Style="{StaticResource DarkButton}"/>
                            </StackPanel>
                            <TextBlock Text="Kézi vezérlésnél a futás megáll, és nem készül napló." Foreground="#5C6370" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. ALSÓ SÁV (Konzol, Napló, Változók) -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Konzol -->
            <Border Grid.Column="0" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Konzol" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <TextBox Background="#181A1F" Foreground="#E6EDF3" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" x:Name="tbKonzol"/>
                </DockPanel>
            </Border>

            <!-- Napló -->
            <Border Grid.Column="1" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Napló" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="" Foreground="#9DA5B4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Background="#181A1F" Foreground="#E6EDF3" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" 
                             x:Name="tbNapló"/>
                </DockPanel>
            </Border>

            <!-- Változók -->
            <Border Grid.Column="2" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Változók" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <ListView x:Name="lvValtozok" Background="#181A1F" Foreground="#E6EDF3" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Név" Width="90" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Típus" Width="90" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Érték" Width="90" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>