<Window x:Class="Robotszimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Robotszimulator"
        mc:Ignorable="d"
        Title="Robot Szimulátor" Height="800" Width="1500" WindowState="Maximized" Background="#16181D" Foreground="White"
        Icon="Logo.png" PreviewKeyDown="Ablak_PreviewKeyDown" SourceInitialized="Ablak_SourceInitialized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="LogikaiLathatosag"/>
        <!-- Sötét kártya stílus -->
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#282C34"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#282C34"/>
            <!-- Sötét háttér -->
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <!-- Világos szöveg -->
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBd" 
                        Background="#282C34" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Amikor az egér a fejléc fölé ér (Hover) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBd" Property="Background" Value="#3A3F4B"/>
                            </Trigger>
                            <!-- Amikor rákattintanak / lenyomják -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBd" Property="Background" Value="#4B5263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            SnapsToDevicePixels="True" 
                            CornerRadius="4" 
                            Margin="2,1">
                            <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Egér húzása a sor felett (Hover) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2F3A"/>
                            </Trigger>
                            <!-- Amikor a sor ki van jelölve -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4451"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMPLETE DARK COMBOBOX STYLE -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <!-- Fő keret a zárt állapothoz -->
                            <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4"/>

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <!-- A kijelölt elem szövege -->
                                <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                                <!-- Nyíl ikon -->
                                <Path x:Name="Arrow" 
                              Grid.Column="1" 
                              Data="M 0 0 L 4 4 L 8 0 Z" 
                              Fill="#9DA5B4" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>

                                <!-- Átlátszó gomb a kattintás elkapásához -->
                                <ToggleButton x:Name="ToggleButton" 
                                      Grid.ColumnSpan="2" 
                                      Focusable="False" 
                                      ClickMode="Press" 
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <!-- Lenyíló lista kerete (Popup) -->
                            <Popup x:Name="PART_Popup" 
                           AllowsTransparency="True" 
                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                           Placement="Bottom" 
                           PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                Background="#21252B" 
                                BorderBrush="#3A3F4B" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Margin="0,2,0,0"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True" Margin="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Egér rámutatás a ComboBox-ra -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2F3A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4B5263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ELEMEK (ComboBoxItem) STÍLUSA -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" 
                        Background="{TemplateBinding Background}" 
                        Padding="{TemplateBinding Padding}" 
                        CornerRadius="3" 
                        Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2F3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E4451"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4" 
                        SnapsToDevicePixels="True">
                            <!-- A StackPanel közvetlenül magába foglalja a menüpontokat, így eltűnik a bal oldali sáv -->
                            <StackPanel IsItemsHost="True" 
                                KeyboardNavigation.DirectionalNavigation="Cycle" 
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kijelző kártyák (Energia, Fúrófej, Arany, Irány, Szenzor) -->
        <Style x:Key="MutatoKartya" TargetType="Border">
            <Setter Property="Background" Value="#21252B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,0,6,8"/>
            <Setter Property="BorderBrush" Value="#282C34"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Vékony sáv: a Foreground adja a kitöltés színét, a kód állítja (zöld / sárga / piros, kék / piros) -->
        <Style x:Key="KijelzoSav" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#98C379"/>
            <Setter Property="Background" Value="#3A3F4B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nyomkövetés kapcsoló -->
        <Style x:Key="Kapcsolo" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Sav" Width="34" Height="18" CornerRadius="9" Background="#3A3F4B" Margin="0,0,8,0">
                                <Ellipse x:Name="Gomb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sav" Property="Background" Value="#61AFEF"/>
                                <Setter TargetName="Gomb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Gomb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Blokk-paletta: "pill" gombok, a Foreground a szöveg, a BorderBrush a keret színe -->
        <Style x:Key="PalettaGomb" TargetType="Button">
            <Setter Property="Foreground" Value="#E5C07B"/>
            <Setter Property="BorderBrush" Value="#8A7440"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="9,2,9,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2C313A"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#3A3F4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PalettaSarga" TargetType="Button" BasedOn="{StaticResource PalettaGomb}"/>
        <Style x:Key="PalettaTeal" TargetType="Button" BasedOn="{StaticResource PalettaGomb}">
            <Setter Property="Foreground" Value="#56B6C2"/>
            <Setter Property="BorderBrush" Value="#33707A"/>
        </Style>
        <Style x:Key="PalettaZold" TargetType="Button" BasedOn="{StaticResource PalettaGomb}">
            <Setter Property="Foreground" Value="#98C379"/>
            <Setter Property="BorderBrush" Value="#5A7545"/>
        </Style>

        <!-- A kijelölt blokksor eszköztárának kis gombjai -->
        <Style x:Key="SorGomb" TargetType="Button">
            <Setter Property="Foreground" Value="#C8CED8"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hatter" Background="#2F3542" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hatter" Property="Background" Value="#3E4451"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hatter" Property="Background" Value="#4B5263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Energia-napló sorai: nincs kijelölés, csak vékony elválasztó -->
        <Style x:Key="EnergiaSorStilus" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="#2A2F3A" BorderThickness="0,0,0,1" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Becsukott paletta kategória-gombjai (négyzet alakú) -->
        <Style x:Key="KategoriaGomb" TargetType="Button">
            <Setter Property="Foreground" Value="#E5C07B"/>
            <Setter Property="BorderBrush" Value="#8A7440"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hatter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hatter" Property="Background" Value="#2C313A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Léptető gombjai: kerek, halvány, ikon-nyilakkal -->
        <Style x:Key="LepteToGomb" TargetType="Button">
            <Setter Property="Foreground" Value="#C8CED8"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hatter" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hatter" Property="Background" Value="#3A3F4B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hatter" Property="Background" Value="#4B5263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Paletta kategóriák: egyszerre egy nyitott (a kódból) -->
        <Style x:Key="PalettaCsoport" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Hatter" Background="#21252B" CornerRadius="5" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                <TextBlock x:Name="Nyil" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#9DA5B4" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hatter" Property="Background" Value="#2C313A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Nyil" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Tartalom" DockPanel.Dock="Top" Margin="0,6,0,2" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Tartalom" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sebesség-csúszka: vékony sín, kék kitöltés, kerek fogó -->
        <Style x:Key="SebessegCsuszka" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#3A3F4B" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#61AFEF" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="20" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Focusable="False" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#E6EDF3" Stroke="#61AFEF" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Felső vezérlősáv -->
            <RowDefinition Height="*"/>
            <!-- 1. Fő munkaterület (Program | Térkép + Kézi vezérlés | Kijelzők) -->
            <RowDefinition Height="230"/>
            <!-- 2. Alsó sáv (Konzol, Napló, Energia-napló, Változók) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Állapotsor -->
        </Grid.RowDefinitions>

        <!-- 0. FELSŐ VEZÉRLŐSÁV -->
        <Border Grid.Row="0" Style="{StaticResource DarkCard}" Margin="0,0,0,6" Padding="10,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button ToolTip="Betöltés" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Padding="10,5" x:Name="BtnBetoltes" Click="BtnBetoltes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonMappa}" Stroke="#E5C07B"/></Canvas></Viewbox>
                            <TextBlock Text="Betöltés" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button ToolTip="Mentés" Style="{StaticResource DarkButton}" Padding="10,5" x:Name="BtnMentes" Click="BtnMentes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonMentes}" Stroke="#61AFEF"/></Canvas></Viewbox>
                            <TextBlock Text="Mentés" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="#3A3F4B" Margin="10,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RunButton}" Margin="0,0,6,0" Padding="14,5" Click="BtnFuttatas_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonLejatszas}" Stroke="#1E1E1E" Fill="#1E1E1E"/></Canvas></Viewbox>
                            <TextBlock Text="Futtatás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnUjrainditas" IsEnabled="False" ToolTip="Újraindítás" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnNyomkovetes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonUjrainditas}" Stroke="#98C379"/></Canvas></Viewbox>
                            <TextBlock Text="Újraindítás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="False" ToolTip="Megállítás" Style="{StaticResource DarkButton}" Padding="10,5" x:Name="btnMegallitas" Click="BtnMegallitas_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonMegallitas}" Stroke="#E06C75" Fill="#E06C75"/></Canvas></Viewbox>
                            <TextBlock Text="Megállítás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="#3A3F4B" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- Léptető: ‹ 3 / 12 › -->
                    <Border Background="#1E1E1E" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="17" Padding="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" ToolTip="Vissza" Style="{StaticResource LepteToGomb}" Click="BtnVissza_Click"/>
                            <TextBlock x:Name="tbLepesSzamlalo" Text="0 / 0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MinWidth="64" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="&#xE76C;" ToolTip="Következő" Style="{StaticResource LepteToGomb}" Click="BtnKovetkezo_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="cbNyomkovetes" Content="Nyomkövetés" Style="{StaticResource Kapcsolo}" IsChecked="True" VerticalAlignment="Center" Foreground="#9DA5B4" FontSize="12"/>
                    <Border Width="1" Height="22" Background="#3A3F4B" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="lassú" VerticalAlignment="Center" Foreground="#9DA5B4" FontSize="12" Margin="0,0,8,0"/>
                    <Slider Style="{StaticResource SebessegCsuszka}" Width="120" VerticalAlignment="Center" Minimum="1" Maximum="10" Value="5" Margin="0,0,8,0" x:Name="slSebesseg" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                    <TextBlock Text="gyors" VerticalAlignment="Center" Foreground="#9DA5B4" FontSize="12"/>
                    <Border Width="1" Height="22" Background="#3A3F4B" Margin="10,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource DarkButton}" Padding="12,5" Click="BtnBeallitasok_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonBeallitasok}" Stroke="#C8CED8"/></Canvas></Viewbox>
                            <TextBlock Text="Beállítások" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. KÖZÉPSŐ FŐ MUNKATERÜLET -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="oszlopProgram" Width="478"/>
                <!-- Bal: Program szerkesztő -->
                <ColumnDefinition Width="*"/>
                <!-- Közép: Térkép + Kézi vezérlés -->
                <ColumnDefinition x:Name="oszlopAllapot" Width="270"/>
                <!-- Jobb: Kijelzők -->
            </Grid.ColumnDefinitions>

            <!-- BAL OLDAL: Program (Blokkok / Szöveg) -->
            <Border Grid.Column="0" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <!-- Fejléc és nézetváltó -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Program" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="tbNemMentett" Text="● nem mentett változás" Foreground="#E5C07B" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnBlokkNezet" Content="Blokkok" Style="{StaticResource DarkButton}" Margin="0,0,4,0" Padding="8,4" Background="#3A3F4B" Click="BtnBlokkNezet_Click"/>
                            <Button x:Name="btnSzovegNezet" Content="Szöveg" Style="{StaticResource DarkButton}" Padding="8,4" Background="#1E1E1E" Click="BtnSzovegNezet_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Kijelölés állapota -->
                    <TextBlock x:Name="tbKijelolesInfo" DockPanel.Dock="Bottom" Foreground="#7D8594" FontSize="11" Margin="0,8,0,0"/>

                    <!-- Paletta (bal oldali, becsukható) + a program -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="pnlBlokkEszkozok" Grid.Column="0" Margin="0,0,10,0">
                            <Grid>
                                <!-- nyitott állapot -->
                                <Border x:Name="pnlPalettaNyitva" Width="176" Background="#1B1E24" BorderBrush="#282C34" BorderThickness="1" CornerRadius="6" Padding="10,8,4,4">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,6,8">
                                            <TextBlock Text="Blokkok" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="28" ToolTip="Paletta becsukása" Style="{StaticResource SorGomb}" HorizontalAlignment="Right" Margin="0" Click="BtnPalettaToggle_Click"/>
                                        </Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,0,8,0">
                                                <Expander x:Name="expMozgas" Style="{StaticResource PalettaCsoport}" Expanded="PalettaCsoport_Expanded" Collapsed="PalettaCsoport_Collapsed">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                                                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonMozgas}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                                                <TextBlock Text="Mozgás" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="2" Foreground="#7D8594" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="StepForward" Content="step forward" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="TurnBy" Content="turn by" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                </StackPanel>
                                                </Expander>
                                                <Expander x:Name="expKozet" Style="{StaticResource PalettaCsoport}" Expanded="PalettaCsoport_Expanded" Collapsed="PalettaCsoport_Collapsed">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                                                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonKo}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                                                <TextBlock Text="Kőzet, energia" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="8" Foreground="#7D8594" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="MineHere" Content="mine here" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="Drill" Content="drill" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="SupportHere" Content="support here" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="UnsupportHere" Content="unsupport here" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="PlaceCharger" Content="place charger" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="RemoveCharger" Content="remove charger" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="Charge" Content="charge" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaSarga}" Tag="BuyDrill" Content="buy drill" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                </StackPanel>
                                                </Expander>
                                                <Expander x:Name="expLista" Style="{StaticResource PalettaCsoport}" Expanded="PalettaCsoport_Expanded" Collapsed="PalettaCsoport_Collapsed">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                                                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonLista}" Stroke="#56B6C2"/></Canvas></Viewbox>
                                                                <TextBlock Text="Lista" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="4" Foreground="#7D8594" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                <Button Style="{StaticResource PalettaTeal}" Tag="ListDecl" Content="list" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaTeal}" Tag="Push" Content="push" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaTeal}" Tag="Put" Content="put" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaTeal}" Tag="Delete" Content="delete" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                </StackPanel>
                                                </Expander>
                                                <Expander x:Name="expVezerles" Style="{StaticResource PalettaCsoport}" IsExpanded="True" Expanded="PalettaCsoport_Expanded" Collapsed="PalettaCsoport_Collapsed">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                                                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonVezerles}" Stroke="#98C379"/></Canvas></Viewbox>
                                                                <TextBlock Text="Vezérlés" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="5" Foreground="#7D8594" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                <Button Style="{StaticResource PalettaZold}" Tag="If" Content="if" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaZold}" Tag="IfElse" Content="if-else" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaZold}" Tag="While" Content="while" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaZold}" Tag="Set" Content="set" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                <Button Style="{StaticResource PalettaZold}" Tag="Print" Content="print" Margin="0,0,0,5" Click="BtnPaletta_Click"/>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- becsukott állapot: csak a kategóriák ikonjai -->
                                <Border x:Name="pnlPalettaZarva" Width="46" Visibility="Collapsed" Background="#1B1E24" BorderBrush="#282C34" BorderThickness="1" CornerRadius="6" Padding="0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Paletta megnyitása" Style="{StaticResource SorGomb}" Width="32" Height="28" Margin="0,0,0,10" Click="BtnPalettaToggle_Click"/>
                                        <Button x:Name="btnKatMozgas" Tag="Mozgas" ToolTip="Mozgás" Style="{StaticResource KategoriaGomb}" Click="BtnKategoria_Click"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonMozgas}"/></Canvas></Viewbox></Button>
                                        <Button x:Name="btnKatKozet" Tag="Kozet" ToolTip="Kőzet, energia" Style="{StaticResource KategoriaGomb}" Click="BtnKategoria_Click"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonKo}"/></Canvas></Viewbox></Button>
                                        <Button x:Name="btnKatLista" Tag="Lista" ToolTip="Lista" Foreground="#56B6C2" BorderBrush="#33707A" Style="{StaticResource KategoriaGomb}" Click="BtnKategoria_Click"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonLista}"/></Canvas></Viewbox></Button>
                                        <Button x:Name="btnKatVezerles" Tag="Vezerles" ToolTip="Vezérlés" Foreground="#98C379" BorderBrush="#5A7545" Style="{StaticResource KategoriaGomb}" Click="BtnKategoria_Click"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonVezerles}"/></Canvas></Viewbox></Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <!-- Blokkok listája és szöveges nézet -->
                            <Grid>
                                <ListBox x:Name="lbBlokkok" Background="#181A1F" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 FontFamily="Consolas" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyDown="LbBlokkok_KeyDown" MouseDoubleClick="LbBlokkok_MouseDoubleClick" SelectionChanged="LbBlokkok_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,3"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Hatter" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>

                                                                <!-- Eszköztár: csak a kijelölt soron látszik -->
                                                                <StackPanel x:Name="Eszkozok" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0" Visibility="Collapsed">
                                                                    <Button Content="←" ToolTip="Ki a szülő while/if blokkból (mögé)" Style="{StaticResource SorGomb}" Click="BtnBlokkKi_Click"/>
                                                                    <Button Content="→" ToolTip="Be a szomszédos while/if blokkba" Style="{StaticResource SorGomb}" Click="BtnBlokkBe_Click"/>
                                                                    <Button Content="↑" ToolTip="Fel" Style="{StaticResource SorGomb}" Click="BtnBlokkFel_Click"/>
                                                                    <Button Content="↓" ToolTip="Le" Style="{StaticResource SorGomb}" Click="BtnBlokkLe_Click"/>
                                                                    <Button Content="✎" ToolTip="Szerkesztés" Style="{StaticResource SorGomb}" Click="BtnBlokkSzerkesztes_Click"
                                                                    Visibility="{Binding Szerkesztheto, Converter={StaticResource LogikaiLathatosag}}"/>
                                                                    <Button Content="🗑" ToolTip="Törlés" Style="{StaticResource SorGomb}" Margin="0" Click="BtnBlokkTorles_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Hatter" Property="Background" Value="#20242C"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Hatter" Property="Background" Value="#263043"/>
                                                                <Setter TargetName="Hatter" Property="BorderBrush" Value="#61AFEF"/>
                                                                <Setter TargetName="Eszkozok" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Sorszam}" Width="24" Foreground="#5C6370" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Width="{Binding BalMargo}"/>
                                                <!-- A keret színe a futás közbeni kiemelés (sárga / piros) -->
                                                <Border BorderBrush="{Binding Keret}" BorderThickness="1.5" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Kulcsszo}" Foreground="{Binding Szin}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Margin="8,0,0,0" Background="#2B303A" CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                        Visibility="{Binding VanParameter, Converter={StaticResource LogikaiLathatosag}}">
                                                            <TextBlock Text="{Binding Parameterek}" Foreground="#E6EDF3" FontWeight="SemiBold" FontSize="12"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="pnlProgramUres" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="26" Height="26" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonLista}" Stroke="#5C6370"/></Canvas></Viewbox>
                                    <TextBlock Text="A program még üres." Foreground="#7D8594" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Válassz egy blokkot a palettáról." Foreground="#7D8594" FontSize="12.5" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Grid x:Name="gdSzovegNezet" Visibility="Collapsed" Background="#181A1F">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1E2128" ClipToBounds="True" MinWidth="34">
                                        <TextBlock x:Name="tbSorszamok" FontFamily="Consolas" FontSize="13" Foreground="#5C6370" TextAlignment="Right" Margin="6,2,8,0"/>
                                    </Border>
                                    <TextBox Grid.Column="1" x:Name="tbProgramSzoveg" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Padding="0,2,0,0"
                                     Background="#181A1F" Foreground="#E6EDF3" CaretBrush="White" BorderThickness="0"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#E06C75"
                                     TextChanged="TbProgramSzoveg_TextChanged" ScrollViewer.ScrollChanged="TbProgramSzoveg_ScrollChanged"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- KÖZÉP: Térkép + jelmagyarázat, alatta a Kézi vezérlés -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DarkCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Térkép Canvas / Rács -->
                        <Border Grid.Row="0" Background="#181A1F" CornerRadius="6" BorderBrush="#282C34" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Uniform" Margin="10">
                                    <Canvas x:Name="TerkepCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Viewbox>
                                <StackPanel x:Name="pnlTerkepUres" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Nincs betöltött térkép" Foreground="#C8CED8" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Használd a Betöltés gombot." Foreground="#7D8594" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Jelmagyarázat (kódból töltődik) -->
                        <WrapPanel x:Name="spLegenda" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <!-- Kézi vezérlés: összecsukható panel -->
                <Grid Grid.Row="1" Margin="6,0,6,6">
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12,8">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Kézi vezérlés" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="a futás megáll, és nem készül napló" Foreground="#7D8594" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="btnKezziToggle" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="28" ToolTip="Kézi vezérlés megnyitása" Style="{StaticResource SorGomb}" Margin="0" Click="BtnKezziToggle_Click"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="pnlKezziTartalom" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnKezziFordulas_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonFordulas}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                    <TextBlock Text="Balra fordulás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="tbKezziFordulas" Width="40" Height="30" Background="#1B1E24" Foreground="White" BorderBrush="#3A3F4B" CaretBrush="White" FontFamily="Consolas" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnKezziLepes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonElore}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                    <TextBlock Text="Előre" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="tbKezziLepes" Width="40" Height="30" Background="#1B1E24" Foreground="White" BorderBrush="#3A3F4B" CaretBrush="White" FontFamily="Consolas" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnKezziBanyaszat_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonBanyaszas}" Stroke="#D19A66"/></Canvas></Viewbox>
                                    <TextBlock Text="Bányászás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0" Click="BtnKezziFuras_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonFuro}" Stroke="#61AFEF"/></Canvas></Viewbox>
                                    <TextBlock Text="Fúrás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnTamaszLerak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonTamasz}" Stroke="#98C379"/></Canvas></Viewbox>
                                    <TextBlock Text="Támasz" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0" Click="BtnTamaszFelvesz_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonTamaszFel}" Stroke="#98C379"/></Canvas></Viewbox>
                                    <TextBlock Text="Felvétel" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnToltoallomasLerak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonVilam}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                    <TextBlock Text="Töltőállomás" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0" Click="BtnToltoallomasFelvesz_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonToltoFel}" Stroke="#E5C07B"/></Canvas></Viewbox>
                                    <TextBlock Text="Felvétel" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnToltes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonAkku}" Stroke="#98C379"/></Canvas></Viewbox>
                                    <TextBlock Text="Töltés" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Padding="10,6" Margin="0" Click="BtnFuroFejVasarlas_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonFuro}" Stroke="#61AFEF"/></Canvas></Viewbox>
                                    <TextBlock Text="Új fúrófej" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- JOBB OLDAL: kijelzők -->
            <Grid Grid.Column="2">
                <!-- nyitott állapot -->
                <DockPanel x:Name="pnlAllapotNyitva">
                    <Grid DockPanel.Dock="Top" Margin="8,4,6,10">
                        <TextBlock Text="Állapot" FontWeight="Bold" FontSize="13" Foreground="#C8CED8" VerticalAlignment="Center"/>
                        <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="28" ToolTip="Állapot becsukása" Style="{StaticResource SorGomb}" HorizontalAlignment="Right" Margin="0" Click="BtnAllapotToggle_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Energia -->
                        <Border Grid.Row="0" Style="{StaticResource MutatoKartya}" Margin="6,6,6,8">
                            <StackPanel>
                                <TextBlock Text="Energia" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock x:Name="tbEnergia" Text="–" FontWeight="Bold" FontSize="22" Foreground="#98C379" Margin="0,4,0,6"/>
                                <ProgressBar x:Name="pbEnergia" Style="{StaticResource KijelzoSav}" Minimum="0" Maximum="1" Value="0"/>
                                <TextBlock x:Name="tbEnergiaInfo" Text="" Foreground="#9DA5B4" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fúrófej -->
                        <Border Grid.Row="1" Style="{StaticResource MutatoKartya}">
                            <StackPanel>
                                <TextBlock Text="Fúrófej" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock x:Name="tbFuroFej" Text="–" FontWeight="Bold" FontSize="22" Foreground="#61AFEF" Margin="0,4,0,6"/>
                                <ProgressBar x:Name="pbFuroFej" Style="{StaticResource KijelzoSav}" Foreground="#61AFEF" Minimum="0" Maximum="1" Value="0"/>
                                <TextBlock x:Name="tbFuroFejInfo" Text="" Foreground="#9DA5B4" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Kibányászott arany -->
                        <Border Grid.Row="2" Style="{StaticResource MutatoKartya}">
                            <StackPanel>
                                <TextBlock Text="Kibányászott arany" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock x:Name="tbKibanyaszottArany" Text="0" FontWeight="Bold" FontSize="20" Foreground="#E5C07B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Irány -->
                        <Border Grid.Row="3" Style="{StaticResource MutatoKartya}">
                            <StackPanel>
                                <TextBlock Text="Irány" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock x:Name="tbIrány" Text="–" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Szenzor -->
                        <Border Grid.Row="4" Style="{StaticResource MutatoKartya}">
                            <StackPanel>
                                <TextBlock Text="Szenzor, a robot előtt" Foreground="#9DA5B4" FontSize="11"/>
                                <TextBlock x:Name="tbSzenzor" Text="–" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- becsukott állapot: a legfontosabb értékek keskeny sávban -->
                <Border x:Name="pnlAllapotZarva" Style="{StaticResource DarkCard}" Visibility="Collapsed" Padding="4,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Állapot megnyitása" Style="{StaticResource SorGomb}" Width="32" Height="28" HorizontalAlignment="Center" Margin="0,0,0,12" Click="BtnAllapotToggle_Click"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" ToolTip="Energia">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonAkku}" Stroke="#98C379"/></Canvas></Viewbox>
                            <TextBlock Text="ENERGIA" FontSize="9" Foreground="#7D8594" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Energia: a kitöltés magasságát a kód állítja (üres / teli sor arány) -->
                        <Border Grid.Row="2" Width="8" Margin="0,6" HorizontalAlignment="Center" Background="#3A3F4B" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="sorEnergiaUres" Height="*"/>
                                    <RowDefinition x:Name="sorEnergiaTelt" Height="0*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="savEnergiaTelt" Grid.Row="1" CornerRadius="4" Background="#98C379"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" x:Name="tbEnergiaZarva" FontSize="11" FontWeight="Bold" Foreground="#98C379" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="4" HorizontalAlignment="Center" ToolTip="Fúrófej">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonFuro}" Stroke="#61AFEF"/></Canvas></Viewbox>
                            <TextBlock Text="FÚRÓ" FontSize="9" Foreground="#7D8594" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Furo: a kitöltés magasságát a kód állítja (üres / teli sor arány) -->
                        <Border Grid.Row="5" Width="8" Margin="0,6" HorizontalAlignment="Center" Background="#3A3F4B" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="sorFuroUres" Height="*"/>
                                    <RowDefinition x:Name="sorFuroTelt" Height="0*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="savFuroTelt" Grid.Row="1" CornerRadius="4" Background="#61AFEF"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="6" x:Name="tbFuroFejZarva" FontSize="11" FontWeight="Bold" Foreground="#61AFEF" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="7" HorizontalAlignment="Center">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ikon}" Data="{StaticResource IkonArany}" Stroke="#E5C07B"/></Canvas></Viewbox>
                            <TextBlock Text="ARANY" FontSize="9" Foreground="#7D8594" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="tbAranyZarva" Text="0" FontSize="15" FontWeight="Bold" Foreground="#E5C07B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 2. ALSÓ SÁV (Konzol, Napló, Energia-napló, Változók) -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Konzol -->
            <Border Grid.Column="0" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Konzol" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <TextBox Background="#181A1F" Foreground="#E6EDF3" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" x:Name="tbKonzol"/>
                </DockPanel>
            </Border>

            <!-- Napló -->
            <Border Grid.Column="1" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Napló" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <TextBox Background="#181A1F" Foreground="#E6EDF3" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" x:Name="tbNapló"/>
                </DockPanel>
            </Border>

            <!-- Energia-napló -->
            <Border Grid.Column="2" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Energia-napló" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Művelet" Foreground="#7D8594" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Változás" Foreground="#7D8594" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Maradt" Foreground="#7D8594" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#2A2F3A"/>
                    <ListBox x:Name="lbEnergiaLog" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource EnergiaSorStilus}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Muvelet}" Foreground="#E6EDF3" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Valtozas}" Foreground="{Binding Szin}" FontFamily="Consolas" FontSize="12" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Maradt}" Foreground="#C8CED8" FontFamily="Consolas" FontSize="12" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Változók -->
            <Border Grid.Column="3" Style="{StaticResource DarkCard}">
                <DockPanel>
                    <TextBlock Text="Változók" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <ListView x:Name="lvValtozok" Background="#181A1F" Foreground="AliceBlue" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Név" Width="90" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Típus" Width="100" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Érték" Width="210" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. ÁLLAPOTSOR -->
        <Border Grid.Row="3" Style="{StaticResource DarkCard}" Margin="0,6,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path x:Name="ikAllapotsor" Style="{StaticResource Ikon}" Data="{StaticResource IkonInfo}" Stroke="#9DA5B4"/></Canvas></Viewbox>
                <TextBlock x:Name="tbAllapotsor" Text="Kezdőállapot" Foreground="#9DA5B4" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>